# Copy to .env.local and fill in. .env.local is gitignored.

# Google Places proxy (server-only) and Maps JS (browser-restricted).
# GOOGLE_MAPS_API_KEY must be a separate key restricted to the Places API (New)
# with no HTTP-referrer restriction; the browser key won't work server-side.
# Without it, place search shows "place search isn't available" (#160).
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# Google Identity Services OAuth client ID for the web app.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# auth-server.
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000

# main api server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Offline demo build: serve bundled demo flares instead of calling the api.
# Leave unset for any build real people use.
NEXT_PUBLIC_SEED_DEMO_DATA=

# Public base URL used for absolute link-preview metadata (Open Graph /
# Twitter card, metadataBase) — see spa/lib/site-url.ts. Set this on Vercel
# once the public domain is settled (sponti.fun currently serves a separate
# landing page; https://sponti-flame.vercel.app is the current prod URL).
# Falls back to Vercel's own VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, then
# localhost, so it's safe to leave unset for local dev.
NEXT_PUBLIC_SITE_URL=
