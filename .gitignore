# env files — never commit secrets or local config.
# .env.example is the documented template and may be committed.
.env
.env.*
!.env.example
.vscode
qr-ui-session.json
# os
.DS_Store

# teaching workspace — local learning material, never committed
.teach/

# agent skills + local Claude Code config — installed per-developer, not committed.
# Run the skills installer locally; do not commit the skill files or symlinks.
.agents/
.claude/

# Next.js build output — should only exist inside spa/, never at the repo
# root. Ignored here to prevent stray builds from being committed again.
.next/
