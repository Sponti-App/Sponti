# Copy to api.env on the server and fill in (values: Render dashboard / vault).
# PORT and NODE_ENV are set by docker-compose.yml.
MONGO_URI=
DB_NAME=sponti
ACCESS_JWT_SECRET=
CLIENT_BASE_URL=https://sponti-flame.vercel.app
CORS_ORIGINS=https://sponti-flame.vercel.app,https://sponti-git-dev-spontis-projects.vercel.app,http://localhost:3000,capacitor://localhost
# Server-only key for the Routes API (ETAs): no website restriction, never the
# browser key.
GOOGLE_MAPS_API_KEY=
