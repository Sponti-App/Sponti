# Copy to .env on the server. Public hostnames Caddy serves (and gets
# certificates for). sslip.io resolves <anything>.<ip-with-dashes>.sslip.io
# to that IP, so no DNS setup is needed until we move to real subdomains.
API_HOST=api.152-53-198-143.sslip.io
AUTH_HOST=auth.152-53-198-143.sslip.io

# Branch the server builds from (deploy.sh).
DEPLOY_BRANCH=main
